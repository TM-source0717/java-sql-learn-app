<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import java.net.URL?>

<VBox alignment="CENTER" spacing="15.0" prefWidth="400.0" xmlns:fx="http://github.com/fxml" xmlns="http://javafx.com/javafx/21"
      fx:controller="org.example.sqllearnapp.View.SQLLearnView">

    <stylesheets>
        <URL value="@style.css" />
    </stylesheets>

    <padding>
        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0"/>
    </padding>

    <TextField fx:id="searchParamInput" promptText="ユーザー名で検索..." />

    <ListView fx:id="userListView" prefHeight="260.0" prefWidth="350.0" />

    <HBox spacing="10.0" alignment="CENTER_RIGHT">
        <Button text="選択したユーザーを削除" onAction="#onDeleteButtonClick" styleClass="delete-button"/>
    </HBox>

    <HBox spacing="10.0" alignment="CENTER">
        <TextField fx:id="nameInput" promptText="名前を入力してください" prefWidth="240.0"/>
        <Button text="登録" onAction="#onRegisterButtonClick"/>
    </HBox>
</VBox>